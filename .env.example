# Django deployment settings. A local development secret is generated if SECRET_KEY is blank.
SECRET_KEY=
DEBUG=0
ALLOWED_HOSTS=127.0.0.1,localhost,testserver, .vercel.app
CSRF_TRUSTED_ORIGINS=https://*.vercel.app
ZALO_OA_ID=
DATABASE_URL=

# HTTPS settings default to secure values when DEBUG=False.
SECURE_SSL_REDIRECT=
SESSION_COOKIE_SECURE=
CSRF_COOKIE_SECURE=
SECURE_HSTS_SECONDS=
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
# Set True only behind a trusted reverse proxy that sets X-Forwarded-Proto.
USE_X_FORWARDED_PROTO=False

